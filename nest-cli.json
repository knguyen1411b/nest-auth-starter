{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
     "assets": [
      {
        "include": "core/mail/templates/**/*",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  },
  "generateOptions": {
    "baseDir": "modules",
    "spec": false
  }
}
