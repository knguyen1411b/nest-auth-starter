{
    "name": "nest-auth-starter",
    "version": "1.0.0",
    "description": "NestJS authentication API starter with PostgreSQL, Prisma, rotating sessions and account recovery",
    "author": {
        "name": "Khanh Nguyen"
    },
    "private": true,
    "license": "MIT",
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main.js",
        "build": "nest build",
        "test": "prisma generate && jest --selectProjects unit api --runInBand",
        "test:watch": "prisma generate && jest --selectProjects unit api --watch",
        "test:cov": "prisma generate && jest --selectProjects unit api --runInBand --coverage",
        "test:integration": "prisma generate && jest --selectProjects integration --runInBand",
        "test:regression": "prisma generate && jest --selectProjects regression --runInBand",
        "test:all": "prisma generate && jest --runInBand",
        "test:typecheck": "prisma generate && tsc --project test/tsconfig.json --noEmit",
        "test:lint": "eslint --no-ignore \"test/**/*.ts\" --max-warnings=0",
        "lint:check": "eslint \"src/**/*.ts\" --max-warnings=0",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "ts-node prisma/seed.ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\" --fix",
        "check": "pnpm run db:generate && pnpm run build && pnpm run lint:check && pnpm run test:typecheck && pnpm run test:lint && pnpm test",
        "dev:services": "docker compose up -d --wait"
    },
    "dependencies": {
        "@fastify/compress": "^8.3.1",
        "@fastify/cors": "^11.3.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/multipart": "^9.4.0",
        "@fastify/static": "^10.1.7",
        "@nestjs/common": "^11.2.7",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.7",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-fastify": "^11.2.7",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/throttler": "^6.7.1",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "^0.14.4",
        "cloudinary": "^2.11.0",
        "dotenv": "^18.0.9",
        "fastify": "^5.12.7",
        "handlebars": "^4.7.10",
        "joi": "^18.3.0",
        "js-yaml": "^4.3.2",
        "nodemailer": "^10.2.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/bcrypt": "^6.0.0",
        "@types/jest": "29.5.14",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.20.5",
        "@types/nodemailer": "^8.0.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "jest": "29.7.0",
        "prettier": "^3.9.10",
        "prisma": "^7.10.1",
        "source-map-support": "^0.5.21",
        "ts-jest": "29.4.5",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "packageManager": "pnpm@12.3.4",
    "engines": {
        "node": ">=22.12.0 <25",
        "pnpm": "12.x"
    }
}
