NODE_ENV=development
APP_NAME=nest-auth-starter
APP_VERSION=1.0.0
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
DATABASE_URL=postgresql://nest_auth_starter:nest_auth_starter@127.0.0.1:5432/nest_auth_starter
# Local only. Generate a random production secret; see DEPLOYMENT.md.
JWT_SECRET=development-only-change-before-deployment
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
SESSION_MAX_AGE=2592000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated trusted proxy IPs/CIDRs. Empty means no forwarded IP trust.
TRUST_PROXY=
API_DOCS_VERSION=1.0.0
OPEN_API_VERSION=3.1.0
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=nest-auth-starter <noreply@example.com>
MAIL_USER=
MAIL_PASS=
# Optional. Avatar upload returns 503 until all three credentials are supplied.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nest-auth-starter
CLOUDINARY_PUBLIC_ID_PREFIX=user_
# Seed only: 12–72 UTF-8 bytes, uppercase/lowercase/digit.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
