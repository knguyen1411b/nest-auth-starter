{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "rootDir": "..",
        "strict": false,
        "module": "Node16",
        "moduleResolution": "Node16",
        "isolatedModules": true,
        "paths": {
            "@/*": ["../src/*"],
            "generated/*": ["../generated/*"]
        },
        "types": ["node", "jest"],
        "incremental": false,
        "declaration": false
    },
    "include": ["../src/**/*.ts", "../generated/**/*.ts", "./**/*.ts"]
}
