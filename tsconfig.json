{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],

    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "paths": {
      "@/*": ["./src/*"],
      "generated/*": ["./generated/*"]
    },

    "incremental": true,
    "skipLibCheck": true,

    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "prisma.config.ts", "generated/**/*.ts"],
  "ts-node": {
    "experimentalResolver": true
  }
}
